 },
 "harrat-mujtaba:5-5": {
  "t": "«تسقى» cümlesi {وُجُوهٌ}un ikinci haberidir. «آنية» «عين»in sıfatıdır.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 88,

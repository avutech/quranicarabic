  "at": "2026-10-03T23:43:58+00:00"
 },
 "harrat-mujtaba:5-5": {
  "t": "«ولسوف يعطيك ربك» cümlesi kasemin cevabına ma'tûftur; lâm kasemin cevabıdır.",

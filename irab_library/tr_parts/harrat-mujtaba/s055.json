 },
 "harrat-mujtaba:10-10": {
  "t": "«الأرض», sonrasının açıkladığı mahzûf bir fiilin mef'ûlüdür; takdir edilen fiilin cümlesi (7.) ayetteki «وضع الميزان» cümlesine ma'tûftur.",
  "reviewed": false,

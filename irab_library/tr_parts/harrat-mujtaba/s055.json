 },
 "harrat-mujtaba:35-35": {
  "t": "«يُرْسَل» cümlesi isti'nâfiyyedir. «من نار» câr ve mecrûru «شواظ»ın mahzûf sıfatına mütealliktir. «فلا تنتصران» cümlesi «يُرْسَل» cümlesine ma'tûftur.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 55,
   "ayet_bas": 35,
   "ayet_son": 35,
   "sha1": "8e438b8c30f6292a55be87059c57fa42d39fbde4"

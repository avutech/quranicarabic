 "harrat-mujtaba:6-6": {
  "t": "«الإنسان»: atf-ı beyândır. «إلى ربك» câr ve mecrûru «كادح»a mütealliktir. «كَدْحًا»: mef'ûl-i mutlaktır. «فملاقيه» kavlinde fâ âtıfedir; «ملاقيه» «كادح»a ma'tûftur.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 84,
   "ayet_bas": 6,
   "ayet_son": 6,
   "sha1": "aa1a6eec1363d7a0106ad7c1084c9f6856487398"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:03+00:00"
 },
 "harrat-mujtaba:7-7": {
  "t": "Fâ âtıfedir. «أما»: şart ve tafsil harfidir. «من» şart ismi olup mübtedâdır; «أوتي» cümlesi onun haberidir. «أما من أوتي ...» cümlesi {إِنَّكَ كَادِحٌ} cümlesine ma'tûftur.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 84,
   "ayet_bas": 7,
   "ayet_son": 7,
   "sha1": "f27e838245bd2e8809d738b9482101418f3de3af"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:03+00:00"
 },

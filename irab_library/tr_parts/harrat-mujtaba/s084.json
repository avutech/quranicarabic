{
 "harrat-mujtaba:1-1": {
  "t": "«السماء»: Kendinden sonrakinin tefsir ettiği mahzûf bir fiilin fâilidir. Şartın cevabı mahzûftur, yani: «بُعِثتم» (diriltilirsiniz).",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 84,
   "ayet_bas": 1,
   "ayet_son": 1,
   "sha1": "d768c74fce05dc8c6a360c8c425aeac31ed6b060"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:03+00:00"
 },
 "harrat-mujtaba:2-2": {
  "t": "«وأَذِنَتْ» cümlesi, takdir edilen fiilü'ş-şarta ma'tûftur.",

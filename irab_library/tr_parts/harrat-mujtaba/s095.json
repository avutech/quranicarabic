 },
 "harrat-mujtaba:2-2": {
  "t": "«سينين»: muzâfun ileyh olup fetha ile mecrûrdur, çünkü alemiyet ve ucmet sebebiyle gayr-i munsariftir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 95,
   "ayet_bas": 2,
   "ayet_son": 2,
   "sha1": "e36578a93178031f47db41cc733289950d6396c2"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:4-4": {
  "t": "Kasemin cevabıdır. «في أحسن» câr ve mecrûru «الإنسان»dan hâl olan (mahzûf) bir kelimeye mütealliktir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 95,
   "ayet_bas": 4,
   "ayet_son": 4,
   "sha1": "0950e419f0772dca31c1cf4bc1a1ceb654a8deab"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:5-5": {
  "t": "«أسفل»: mansûb mekân zarfıdır; aslında mahzûf bir mekânın sıfatıdır, yani: «مكانا أسفل». «رددناه» cümlesi kasemin cevabına ma'tûftur.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 95,
   "ayet_bas": 5,
   "ayet_son": 5,
   "sha1": "c834a2a5321e6ddbc70c4f016af9a72c22443351"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:6-6": {
  "t": "«فلهم أجر» cümlesi «وعملوا» cümlesine ma'tûftur. «غير»: sıfattır.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 95,
   "ayet_bas": 6,
   "ayet_son": 6,
   "sha1": "8e301715afa5da1b298f7aa7efba30695f7becbe"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:7-7": {
  "t": "«فما يكذبك» cümlesi isti'nâfiyyedir. «ما»: istifhâm ismi olup mübtedâdır. «بعد»: izâfetten kesilmiş zaman zarfıdır; aslı: «بعد ذِكْر الإنسان» (insanın zikredilmesinden sonra).",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 95,
   "ayet_bas": 7,
   "ayet_son": 7,
   "sha1": "eeba4b7efe229d5528c2497a0062bd0ba4500479"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:8-8": {
  "t": "Cümle isti'nâfiyyedir. Bâ, «ليس»in haberinde zâidedir.",
  "reviewed": false,

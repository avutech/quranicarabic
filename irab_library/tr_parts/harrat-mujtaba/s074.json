 },
 "harrat-mujtaba:27-27": {
  "t": "«وما أدراك» cümlesi, hâl cümlesi ile onun sahibi olan «سقر» arasında i'tirâziyyedir. «ما سقر» cümlesi, istifhâm ile ta'lîk edilen «أدراك»in mef'ûlüdür.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,

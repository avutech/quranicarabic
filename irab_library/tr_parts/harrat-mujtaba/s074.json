   "sure": 74,
   "ayet_bas": 37,
   "ayet_son": 37,
   "sha1": "7a685d1ffdaf16e6597344b2cc8e6f6a1efa6cac"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:39:09+00:00"
 },
 "harrat-mujtaba:38-38": {
  "t": "«ما»: masdariyyedir; müevvel masdar «رهينة»ye mütealliktir.",

 },
 "harrat-mujtaba:29-29": {
  "t": "«لواحة» mahzûf bir mübtedânın haberidir, yani: «هي لواحة»; cümle birinci «سقر»dan ikinci hâldir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 29,
   "ayet_son": 29,
   "sha1": "ea5eac59dbe3e5405b5304b29403ed1b28828e30"

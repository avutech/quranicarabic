 },
 "harrat-mujtaba:30-30": {
  "t": "«تسعة عشر» fetha üzere mebnî iki cüz olup mübtedâdır; cümle üçüncü hâldir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 30,
   "ayet_son": 30,
   "sha1": "c1f858be73f9a9129c5b637a075bb42e75c7e8dc"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:32:40+00:00"
 },
 "harrat-mujtaba:31-31": {
  "t": "«وما جعلنا» cümlesi isti'nâfiyyedir. «إلا» hasr içindir. «ملائكة» ikinci mef'ûldür. «للذين» câr ve mecrûru «فتنة»nin sıfatına mütealliktir. «ليستيقن» mecrûr masdarı ikinci «جعل»e mütealliktir. «إيمانا»: temyîzdir. «ما» istifhâm ismi olup mübtedâdır; «ذا»: ism-i mevsûl olup haberdir. «مثلا»: ism-i işaretten hâldir. «يضل» cümlesi isti'nâfiyyedir; kâf mef'ûl-i mutlakın nâibidir, yani: «يضلُّ الله إضلالا مثل ذلك الإضلال» (Allah o saptırma gibi bir saptırmayla saptırır). «وما يعلم» cümlesi isti'nâfiyyedir; «هو» «يعلم»in fâilidir. «وما هي إلا ذكرى» da öyledir (isti'nâfiyyedir). «للبشر» câr ve mecrûru «ذكرى»nın sıfatına mütealliktir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 31,
   "ayet_son": 31,
   "sha1": "3a499c36480142241b72458f940e5cc0700bd74a"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:39:09+00:00"
 },
 "harrat-mujtaba:32-32": {
  "t": "«والقمر»: vâv kasem içindir; kendisiyle yemin edilen mecrûrdur, takdîrî «أقسم» fiiline mütealliktir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 32,
   "ayet_son": 32,
   "sha1": "3c657367d1c97cdbb5ce09e1268d8f974727261e"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:39:09+00:00"
 },
 "harrat-mujtaba:33-33": {
  "t": "«إذ» zarfı mahzûf «أقسم» fiiline mütealliktir.",

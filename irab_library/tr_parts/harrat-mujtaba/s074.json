  "at": "2026-10-04T04:32:40+00:00"
 },
 "harrat-mujtaba:28-28": {
  "t": "«لا تبقي» cümlesi birinci «سقر»dan hâldir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,

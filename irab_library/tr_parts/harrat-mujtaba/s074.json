 },
 "harrat-mujtaba:8-8": {
  "t": "(فَإِذَا نُقِرَ فِي النَّاقُورِ) [Mütercim notu: tartışılan ifade] Şart cümlesi isti'nâfiyyedir. Câr ve mecrûr nâib-i fâildir. «إذا» şart mânalı zarftır, cevabın mânasına mütealliktir, yani: «فإذا نقر في الناقور عسر الأمر» (sûra üfürüldüğünde iş zorlaşır).",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 8,
   "ayet_son": 8,
   "sha1": "67685aad7cfb21e0be01ff3209304164397a482a"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:39:09+00:00"
 },
 "harrat-mujtaba:9-9": {
  "t": "«يومئذ» «فذلك»ten bedeldir; mebnî bir şeye muzâf olduğu için mebnî kılınmıştır. «إذٍ» sükûn üzere mebnî zarf ismi olup muzâfun ileyhtir; tenvin ivaz içindir. «عسير» sözü: «يوم»ün sıfatıdır.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 9,
   "ayet_son": 9,
   "sha1": "05c12370cc0a15aa4bfe7bf8be248b5809a9e91f"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:31:59+00:00"
 },
 "harrat-mujtaba:10-10": {
  "t": "«غير» «يوم»ün ikinci sıfatıdır. «على الكافرين» câr ve mecrûru {عَسِيرٌ}e mütealliktir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 10,
   "ayet_son": 10,
   "sha1": "f0656b7be6f4a4ad1b4cbda5e285886c949f947b"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:39:09+00:00"
 },
 "harrat-mujtaba:11-11": {
  "t": "«ذرني» cümlesi isti'nâfiyyedir. «من» ism-i mevsûl olup yâya ma'tûftur. «وحيدا» «خلقت»teki takdîrî zamirden hâldir, yani: «خلقته وحيدا» (onu tek başına yarattım).",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 11,
   "ayet_son": 11,
   "sha1": "00e1b465165c97ee8a3baae17e5e43e396750cfe"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:31:59+00:00"
 },
 "harrat-mujtaba:12-12": {
  "t": "«له» câr ve mecrûru ikinci mef'ûle mütealliktir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 12,
   "ayet_son": 12,
   "sha1": "d0878150f3c62b08565cc5330f3a4a39d99d03e0"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:39:09+00:00"
 },
 "harrat-mujtaba:15-15": {
  "t": "«أن أزيد» masdarı nez'u'l-hâfıd ile mansûbdur, yani: «في الزيادة» (artırmada).",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 74,
   "ayet_bas": 15,
   "ayet_son": 15,
   "sha1": "2832e8e8b3935dd3e40a6ab8390cc8c616af228a"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:31:59+00:00"
 },
 "harrat-mujtaba:16-16": {
  "t": "«لآياتنا» câr ve mecrûru, «جاحدا» (inkâr eden) mânasını tazammun eden «عنيدا»ya mütealliktir.",
  "reviewed": false,
  "src": {

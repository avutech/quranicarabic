  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 53,
   "ayet_bas": 32,
   "ayet_son": 32,
   "sha1": "49f95712ffdf5ca53e1a4e98f90bd717b2396154"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-04T04:30:46+00:00"
 },

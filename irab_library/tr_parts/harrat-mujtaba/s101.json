 "harrat-mujtaba:2-2": {
  "t": "«ما»: istifhâm ismi olup mübtedâdır; «القارعة»: haberdir. Cümle, önceki mübtedânın haberidir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 101,
   "ayet_bas": 2,
   "ayet_son": 2,
   "sha1": "f5a04f9121d017944dd0ce082415aed304c221f4"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:3-3": {
  "t": "Vâv isti'nâfiyyedir. «ما القارعة» cümlesi «أدراك»in ikinci mef'ûlüdür. «وما أدراك» cümlesi {مَا الْقَارِعَةُ} cümlesine ma'tûftur.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 101,
   "ayet_bas": 3,
   "ayet_son": 3,
   "sha1": "b51f29093f9d10924c5f100bf3ac1e3708c3d02f"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:4-4": {
  "t": "«يوم»: zarf olup takdir edilen bir fiile mütealliktir; takdiri: «تأتي يوم يكون» (… olacağı gün gelir). «تأتي» cümlesi isti'nâfiyyedir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 101,
   "ayet_bas": 4,
   "ayet_son": 4,
   "sha1": "d8ddfabffe849067fcd57505378e7c8ae690f3f7"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:6-6": {
  "t": "Fâ isti'nâfiyyedir. «أمَّا»: şart ve tafsil harfidir. «مَنْ»: mevsûl olup mübtedâdır.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 101,
   "ayet_bas": 6,
   "ayet_son": 6,
   "sha1": "61b57044366d8823619e85bcb05d67afcae61fdf"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:7-7": {
  "t": "Fâ râbıtadır; «هو في عيشة» cümlesi önceki «مَنْ» mübtedâsının haberidir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 101,
   "ayet_bas": 7,
   "ayet_son": 7,
   "sha1": "a0da36f46d8de9aae8b865043b3e23d56865e316"
  },
  "by": "Claude (makine çevirisi)",
  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:8-8": {
  "t": "«وأمَّا مَنْ خَفَّت» cümlesi «أمَّا مَنْ ثقلت» cümlesine ma'tûftur.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",
   "sure": 101,
   "ayet_bas": 8,
   "ayet_son": 8,

  "at": "2026-10-03T23:41:37+00:00"
 },
 "harrat-mujtaba:9-9": {
  "t": "Cümle, ikinci mübtedâ olan {مَنْ خَفَّتْ}in haberidir.",
  "reviewed": false,
  "src": {
   "book": "harrat-mujtaba",

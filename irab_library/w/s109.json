","tr":"ve banadır","pa":"حرف عطف + حرف جر + ضمير","pt":"Atıf harfi + Harf-i cer + Zamir","da":"متكلم مفرد","dt":"Mütekellim müfred","r":""},{"ar":"دِينِ","tl":"dīni","en":"(is) my religion","tr":"dinim","pa":"اسم + ضمير","pt":"İsim + Zamir","da":"مرفوع، مذكر","dt":"Merfû, Müzekker","r":"د ي ن"}]}}
ap."},"w":[{"ar":"وَطَعَامًۭا","tl":"waṭaʿāman","en":"And food","tr":"ve yemek","pa":"حرف عطف + اسم","pt":"Atıf harfi + İsim","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"ط ع م"},{"ar":"ذَا","tl":"dhā","en":"that","tr":"(-e) sahip","pa":"اسم","pt":"İsim","da":"منصوب، مذكر مفرد","dt":"Mansûb, Müzekker müfred","r":""},{"ar":"غُصَّةٍۢ","tl":"ghuṣṣatin","en":"chokes","tr":"boğazda düğümlenen","pa":"اسم","pt":"İsim","da":"مجرور، مؤنث","dt":"Mecrûr, Müennes","r":"غ ص ص"},{"ar":"وَعَذَابًا","tl":"waʿadhāban","en":"and a punishment","tr":"ve bir azap","pa":"حرف عطف + اسم","pt":"Atıf harfi + İsim","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"ع ذ ب"},{"ar":"أَلِيمًۭا","tl":"alīman","en":"painful","tr":"elem dolu","pa":"صفة","pt":"Sıfat","da":"منصوب، مذكر مفرد","dt":"Mansûb, Müzekker müfred","r":"أ ل م"}]},"14":{"m":{"210":"O günde yer ve dağlar sarsılır, dağlar da yığılarak akıp dağılan kum gibi olur.","77":"Kıyametin koptuğu gün, yeryüzü ve dağlar sarsılır; dağlar, yumuşak kum yığını haline gelir.","52":"O gün yer ve dağlar sarsılacak, dağlar erimiş bir kum yığınına dönecek.","112":"O gün, yeryüzü ve dağlar yerinden oynar ve dağlar akıp giden kum yığınları haline döner.","124":"O gün (kıyamet günü) yeryüzü ve dağlar sarsılır, dağlar çöküntü ile akıp giden kum yığınına döner."},"w":[{"ar":"يَوْمَ","tl":"yawma","en":"(On the) Day","tr":"gün","pa":"ظرف زمان","pt":"Zaman zarfı","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"ي و م"},{"ar":"تَرْجُفُ","tl":"tarjufu","en":"will quake","tr":"sarsılacak","pa":"فعل مضارع","pt":"Fi'l-i muzâri","da":"الوزن I، مرفوع، غائب مؤنث مفرد","dt":"mücerred bâbı, Merfû, Gâib müennes müfred","r":"ر ج ف"},{"ar":"ٱلْأَرْضُ","tl":"l-arḍu","en":"the earth","tr":"yer","pa":"اسم","pt":"İsim","da":"مرفوع، مؤنث","dt":"Merfû, Müennes","r":"أ ر ض"},{"ar":"وَٱلْجِبَالُ","tl":"wal-jibālu","en":"and the mountains","tr":"ve dağlar","pa":"حرف عطف + اسم","pt":"Atıf harfi + İsim","da":"مرفوع، مذكر جمع","dt":"Merfû, Müzekker cemi","r":"ج ب ل"},{"ar":"وَكَانَتِ
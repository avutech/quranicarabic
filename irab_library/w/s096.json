d","r":"ر أ ي"}]},"15":{"m":{"20":"No! If he does not desist, We will surely drag him by the forelock","85":"No! If he does not stop, We shall drag him by his forehead––","210":"Hayır! Eğer son vermezse, elbette perçeminden yakalayıp sürükleriz.","77":"Ama bundan vazgeçmezse, and olsun ki, onu perçeminden,","52":"Hayır, hayır! Eğer o, bu davranışından vazgeçmezse, and olsun ki biz, onu perçeminden, o günahkâr ve yalancı perçeminden tutup cehenneme sürükleriz.","112":"Hayır! Eğer son vermezse, elbette perçeminden yakalayıp, sürükleriz.","124":"Hayır, hayır! Eğer vazgeçmezse, derhal onu alnından (perçeminden),"},"w":[{"ar":"كَلَّا","tl":"kallā","en":"Nay","tr":"hayır! (red' ve zecr)","pa":"حرف ردع","pt":"Red' harfi","da":"","dt":"","r":""},{"ar":"لَئِن","tl":"la-in","en":"If","tr":"andolsun eğer","pa":"لام التوكيد + أداة شرط","pt":"Te'kîd lâmı + Şart edatı","da":"","dt":"","r":""},{"ar":"لَّمْ","tl":"lam","en":"not","tr":"-mezse","pa":"حرف نفي","pt":"Nefy harfi","da":"","dt":"","r":""},{"ar":"يَنتَهِ","tl":"yantahi","en":"he desists","tr":"vazgeçmezse","pa":"فعل مضارع","pt":"Fi'l-i muzâri","da":"الوزن VIII، مجزوم، غائب مذكر مفرد","dt":"iftiâl bâbı, Meczûm, Gâib müzekker müfred","r":"ن ه ي"},{"ar":"لَنَسْفَعًۢا","tl":"lanasfaʿan","en":"surely We will drag him","tr":"elbette sürükleriz","pa":"لام التوكيد + فعل مضارع + لام التوكيد","pt":"Te'kîd lâmı + Fi'l-i muzâri + Te'kîd lâmı","da":"الوزن I، مرفوع، متكلم جمع","dt":"mücerred bâbı, Merfû, Mütekellim cemi","r":"س ف ع"},{"ar":"بِٱلنَّاصِيَةِ","tl":"bil-nāṣiyati","en":"by the forelock","tr":"perçeminden (alnından)","pa":"حرف جر + اسم","pt":"Harf-i cer + İsim","da":"مجرور، مؤنث","dt":"Mecrûr, Müennes","r":"ن ص ي"}]},"16":{"m":{"20":"A lying, sinning forelock.","85":"his lying, sinful forehead.","210":"Yalancı, günahkâr perçeminden.","77":"Yalancı ve günahkar perçeminden cehenneme sürükleriz.","52":"Hayır, hayır! Eğer o, bu davranışından vazgeçmezse, and olsun ki biz, onu perçeminden, o günahkâr ve yalancı perçeminden tutup cehenneme sürükleriz.","112":"Yalancı, günahkâr perçeminden.","124":"o yalancı, günahkâr alından (perçemden) yakalarız (cehenneme atarız)."},"w":[{"ar":"نَاصِيَةٍۢ","tl":"nāṣiyatin","en":"A forelock","tr":"bir perçem(den)","pa":"اسم","pt":"İsim","da":"مجرور، مؤنث","dt":"Mecrûr, Müennes","r":"ن ص ي"},{"ar":"كَـٰذِبَةٍ","tl":"kādhibatin","en":"lying","tr":"yalancı","pa":"صفة","pt":"Sıfat","da":"اسم فاعل، مجرور، مؤنث","dt":"İsm-i fâil, Mecrûr, Müennes","r":"ك ذ ب"},{"ar":"خَاطِئَةٍۢ","tl":"khāṭi-atin","en":"sinful","tr":"günahkâr","pa":"صفة","pt":"Sıfat","da":"اسم فاعل، مجرور، مؤنث","dt":"İsm-i fâil, Mecrûr, Müennes","r":"خ ط أ"}]},"17":{"m":{"20":"Then let him call his associates;","85":"Let him summon his comrades;","210":"Haydi! O meclisini /Taraftarlarını çağırsın.","77":"O zaman, kafadarlarını çağırsın,","52":"O zaman o taraftarlarını yardıma çağırsın.","112":"Haydi çağırsın meclisini.","124":"O, hemen gidip meclisini (kendi taraftarlarını) çağırsın."},"w":[{"ar":"فَلْيَدْعُ","tl":"falyadʿu","en":"Then let him call","tr":"o halde çağırsın","pa":"حرف استئناف + فعل أمر + فعل مضارع","pt":"İsti'nâf harfi + Fi'l-i emr + Fi'l-i muzâri","da":"الوزن I، مجزوم، غائب مذكر مفرد","dt":"mücerred bâbı, Meczûm, Gâib müzekker müfred","r":"د ع و"},{"ar":"نَادِيَهُۥ","tl":"nādiyahu","en":"his associates","tr":"meclisini (yandaşlarını)","pa":"اسم + ضمير","pt":"İsim + Zamir","da":"اسم فاعل، منصوب، مذكر","dt":"İsm-i fâil, Mansûb, Müzekker","r":"ن د و"}]},"18":{"m":{"20":"We will call the angels of Hell.","85":"We shall summon the guards of Hell.","210":"Biz de Zebanileri çağıracağız.","77":"Biz de zebanileri çağıracağız.","52":"Biz de Zebanileri çağıracağız.","112":"Çağıracağız zebanileri.","124":"Biz de zebanileri çağıracağız"},"w":[{"ar":"سَنَدْعُ","tl":"sanadʿu","en":"We will call","tr":"biz de çağıracağız","pa":"حرف استقبال + فعل مضارع","pt":"İstikbâl harfi + Fi'l-i muzâri","da":"الوزن I، مرفوع، متكلم جمع","dt":"mücerred bâbı, Merfû, Mütekellim cemi","r":"د ع و"},{"ar":"ٱلزَّبَانِي
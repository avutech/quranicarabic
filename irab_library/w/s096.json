{"1":{"m":{"20":"Recite in the name of your Lord who created","85":"Read! In the name of your Lord who created:","210":"Yaratan Rabbinin adıyla oku!","77":"Yaratan Rabbinin adıyla oku!","52":"Yaratan Rabbinin adıyla oku!","112":"Oku! Yaratan Rabbinin adıyla.","124":"Yaratan Rabbinin adıyla oku!"},"w":[{"ar":"ٱقْرَأْ","tl":"iq'ra","en":"Read","tr":"oku","pa":"فعل أمر","pt":"Fi'l-i emr","da":"الوزن I، مخاطب مذكر مفرد","dt":"mücerred bâbı, Muhâtab müzekker müfred","r":"ق ر أ"},{"ar":"بِٱسْمِ","tl":"bi-is'mi","en":"in (the) name","tr":"adıyla","pa":"حرف جر + اسم","pt":"Harf-i cer + İsim","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"س م و"},{"ar":"رَبِّكَ","tl":"rabbika","en":"(of) your Lord","tr":"Rabbinin","pa":"اسم + ضمير","pt":"İsim + Zamir","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"ر ب ب"},{"ar":"ٱلَّذِى","tl":"alladhī","en":"the One Who","tr":"ki O","pa":"اسم موصول","pt":"İsm-i mevsûl","da":"مذكر مفرد","dt":"Müzekker müfred","r":""},{"ar":"خَلَقَ","tl":"khalaqa","en":"created ","tr":"yarattı","pa":"فعل ماض","pt":"Fi'l-i mâzî","da":"الوزن I، غائب مذكر مفرد","dt":"mücerred bâbı, Gâib müzekker müfred","r":"خ ل ق"}]},"2":{"m":{"20":"Created man from a clinging substance.","85":"He created manfrom a clinging form.","210":"O, insanı bir kan pıhtısından yarattı.","77":"O, insanı pıhtılaşmış kandan (alak'tan) yarattı.","52":"O, insanı bir alekadan (embriyodan) yarattı.","112":"İnsanı alaktan yaratan,","124":"O, insanı alâk (rahim cidarına asılı hücre kümesi) tan yarattı."},"w":[{"ar":"خَلَقَ","tl":"khalaqa","en":"He created","tr":"yarattı","pa":"فعل ماض","pt":"Fi'l-i mâzî","da":"الوزن I، غائب مذكر مفرد","dt":"mücerred bâbı, Gâib müzekker müfred","r":"خ ل ق"},{"ar":"ٱلْإِنسَـٰنَ","tl":"l-insāna","en":"man","tr":"insanı","pa":"اسم","pt":"İsim","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"أ ن س"},{"ar":"مِنْ","tl":"min","en":"from","tr":"-den","pa":"حرف جر","pt":"Harf-i cer","da":"","dt":"","r":""},{"ar":"عَلَقٍ","tl":"ʿalaqin","en":"a clinging substance","tr":"bi
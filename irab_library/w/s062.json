l":"wahuwa","en":"and He","tr":"","pa":"حرف استئناف + ضمير","pt":"İsti'nâf harfi + Zamir","da":"غائب مذكر مفرد","dt":"Gâib müzekker müfred","r":""},{"ar":"ٱلْعَزِيزُ","tl":"l-ʿazīzu","en":"(is) the All-Mighty","tr":"","pa":"اسم","pt":"İsim","da":"مرفوع، مذكر مفرد","dt":"Merfû, Müzekker müfred","r":"ع ز ز"},{"ar":"ٱلْحَكِيمُ","tl":"l-ḥakīmu","en":"the All-Wise","tr":"","pa":"صفة","pt":"Sıfat","da":"مرفوع، مذكر مفرد","dt":"Merfû, Müzekker müfred","r":"ح ك م"}]},"4":{"m":{"210":"Bu, Allah’ın dilediğine verdiği bir lütuftur. Allah, büyük lütuf sahibidir.","77":"Bu, Allah'ın dilediğine verdiği lütfüdür. Allah, büyük lütuf sahibidir.","52":"Bu, Allah'ın lütfudur. Allah, büyük lütuf sahibidir.","112":"Bu, Allah’ın dilediğine verdiği bir lütuftur. Allah büyük lütuf sahibidir.","124":"Bu, Allah'ın lütfudur. Onu dilediğine verir. Allah büyük lütuf sahibidir."},"w":[{"ar":"ذَٰلِكَ","tl":"dhālika","en":"That","tr":"","pa":"اسم إشارة","pt":"İsm-i işaret","da":"مذكر مفرد","dt":"Müzekker müfred","r":""},{"ar":"فَضْلُ","tl":"faḍlu","en":"(is the) Bounty","tr":"","pa":"اسم","pt":"İsim","da":"مرفوع، مذكر","dt":"Merfû, Müzekker","r":"ف ض ل"},{"ar":"ٱللَّهِ","tl":"l-lahi","en":"(of) Allah","tr":"","pa":"اسم علم","pt":"Özel isim","da":"مجرور","dt":"Mecrûr","r":"أ ل ه"},{"ar":"يُؤْتِيهِ","tl":"yu'tīhi","en":"He gives it","tr":"","pa":"فعل مضارع + ضمير","pt":"Fi'l-i muzâri + Zamir","da":"الوزن IV، مرفوع، غائب مذكر مفرد","dt":"if'âl bâbı, Merfû, Gâib müzekker müfred","r":"أ ت ي"},{"ar":"مَن","tl":"man","en":"(to) whom","tr":"","pa":"اسم موصول","pt":"İsm-i mevsûl","da":"","dt":"","r":""},{"ar":"يَشَآءُ ۚ","tl":"yashāu","en":"He wills","tr":"","pa":"فعل مضارع","pt":"Fi'l-i muzâri","da":"الوزن I، مرفوع، غائب مذكر مفرد","dt":"mücerred bâbı, Merfû, Gâib müzekker müfred","r":"ش ي أ"},{"ar":"وَٱللَّهُ","tl":"wal-lahu","en":"And Allah","tr":"","pa":"حرف استئناف + اسم علم","pt":"İsti'nâf harfi + Özel isim","da":"مرفوع","dt":"Merfû","r":"أ ل ه"},{"ar":"ذُو","tl":"dhū","en":"(is the) Possessor","tr":"","pa":"اسم","pt":"İsim","da":"مرفوع، مذكر مفرد","dt":"Merfû, Müzekker müfred","r":""},{"ar":"ٱلْفَضْلِ","tl":"l-faḍli","en":"(of) Bounty","tr":"","pa":"اسم","pt":"İsim","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"ف ض ل"},{"ar":"ٱلْعَظِيمِ","tl":"l-ʿaẓīmi","en":"the Great","tr":"","pa":"صفة","pt":"Sıfat","da":"مجرور، مذكر مفرد","dt":"Mecrûr, Müzekker müfred","r":"ع ظ م"}]},"5":{"m":{"210":"Tevrat'la yükümlü tutulup da daha sonra taşımayanların/amel etmeyenlerin örneği, kitap yüklü eşeğe benzer. Allah’ın ayetlerini yalanlayan bir toplumun hali ne kötüdür. Allah, zalim topluma hidayet etmez.","77":"Kendilerine Tevrat öğretildiği halde, onun gereğini yapmayanların durumu, sırtına kitap yüklenmiş merkebin durumu gibidir. Allah'ın ayetlerini yalanlayan kimselerin durumu ne kötüdür! Allah zalimleri doğru yola eriştirmez.","52":"Kendilerine Tevrat yükletilip de sonra onu taşımayanların durumu, kitaplar taşıyan eşeğin durumu gibidir. Allah'ın âyetlerini yalanlayanların durumu ne kötüdür. Allah zalim toplumu doğru yola iletmez.","112":"Tevrat'la yükümlü tutulup da daha sonra taşımayanların/amel etmeyenlerin örneği, kitap yüklü eşeğe benzer. Allah’ın ayetlerini yalanlayan bir toplumun hali ne kötüdür. Allah zalim topluma hidayet etmez.","124":"Tevratla yükümlü tutulup da onunla amel etmeyenlerin durumu, ciltlerce kitap taşıyan merkebin durumu gibidir. Allah'ın âyetlerini yalanlamış olan kavmin durumu ne kötüdür! Allah, zalimler topluluğunu doğru yola iletmez."},"w":[{"ar":"مَثَلُ","tl":"mathalu","en":"(The) likeness","tr":"","pa":"اسم","pt":"İsim","da":"مرفوع، مذكر","dt":"Merfû, Müzekker","r":"م ث ل"},{"ar":"ٱلَّذِينَ","tl":"alladhīna","en":"(of) those who","tr":"","pa":"اسم موصول","pt":"İsm-i mevsûl","da":"مذكر جمع","dt":"Müzekker cemi","r":""},{"ar":"حُمِّلُوا۟","tl":"ḥummilū","en":"were entrusted","tr":"","pa":"فعل ماض + ضمير","pt":"Fi'l-i mâzî + Zamir","da":"الوزن II، مبني للمجهول، غائب مذكر جمع","dt":"tef'îl bâbı, meçhul, Gâib müzekker cemi","r":"ح م ل"},{"ar":"ٱلت
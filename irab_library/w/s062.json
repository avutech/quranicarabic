":"فعل أمر","pt":"Fi'l-i emr","da":"الوزن I، مخاطب مذكر مفرد","dt":"mücerred bâbı, Muhâtab müzekker müfred","r":"ق و ل"},{"ar":"يَـٰٓأَيُّهَا","tl":"yāayyuhā","en":"O","tr":"","pa":"حرف نداء + اسم","pt":"Nidâ harfi + İsim","da":"مرفوع","dt":"Merfû","r":""},{"ar":"ٱلَّذِينَ","tl":"alladhīna","en":"you (who)","tr":"","pa":"اسم موصول","pt":"İsm-i mevsûl","da":"مذكر جمع","dt":"Müzekker cemi","r":""},{"ar":"هَادُوٓا۟","tl":"hādū","en":"(are) Jews","tr":"","pa":"فعل ماض + ضمير","pt":"Fi'l-i mâzî + Zamir","da":"الوزن I، غائب مذكر جمع","dt":"mücerred bâbı, Gâib müzekker cemi","r":"ه و د"},{"ar":"إِن","tl":"in","en":"If","tr":"","pa":"أداة شرط","pt":"Şart edatı","da":"","dt":"","r":""},{"ar":"زَعَمْتُمْ","tl":"zaʿamtum","en":"you claim","tr":"","pa":"فعل ماض + ضمير","pt":"Fi'l-i mâzî + Zamir","da":"الوزن I، مخاطب مذكر جمع","dt":"mücerred bâbı, Muhâtab müzekker cemi","r":"ز ع م"},{"ar":"أَنَّكُمْ","tl":"annakum","en":"that you","tr":"","pa":"حرف نصب + ضمير","pt":"Nasb harfi + Zamir","da":"","dt":"","r":""},{"ar":"أَوْلِيَآءُ","tl":"awliyāu","en":"(are) allies","tr":"","pa":"اسم","pt":"İsim","da":"مرفوع، مذكر جمع","dt":"Merfû, Müzekker cemi","r":"و ل ي"},{"ar":"لِلَّهِ","tl":"lillahi","en":"of Allah","tr":"","pa":"حرف جر + اسم علم","pt":"Harf-i cer + Özel isim","da":"مجرور","dt":"Mecrûr","r":"أ ل ه"},{"ar":"مِن","tl":"min","en":"from","tr":"","pa":"حرف جر","pt":"Harf-i cer","da":"","dt":"","r":""},{"ar":"دُونِ","tl":"dūni","en":"excluding","tr":"","pa":"اسم","pt":"İsim","da":"مجرور","dt":"Mecrûr","r":"د و ن"},{"ar":"ٱلنَّاسِ","tl":"l-nāsi","en":"the people","tr":"","pa":"اسم","pt":"İsim","da":"مجرور، مذكر جمع","dt":"Mecrûr, Müzekker cemi","r":"ن و س"},{"ar":"فَتَمَنَّوُا۟","tl":"fatamannawū","en":"then wish","tr":"","pa":"حرف جواب الشرط + فعل أمر + ضمير","pt":"Şart cevabı harfi + Fi'l-i emr + Zamir","da":"الوزن V، مخاطب مذكر جمع","dt":"tefa''ul bâbı, Muhâtab müzekker cemi","r":"م ن ي"},{"ar":"ٱلْمَوْتَ","tl":"l-mawta","en":"(for) the death","tr":"","pa":"اسم","pt":"İsim","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"م و ت"},{"ar":"إِن","tl":"in","en":"if","tr":"","pa":"أداة شرط","pt":"Şart edatı","da":"","dt":"","r":""},{"ar":"كُنتُمْ","tl":"kuntum","en":"you are","tr":"","pa":"فعل ماض + ضمير","pt":"Fi'l-i mâzî + Zamir","da":"الوزن I، مخاطب مذكر جمع","dt":"mücerred bâbı, Muhâtab müzekker cemi","r":"ك و ن"},{"ar":"صَـٰدِقِينَ","tl":"ṣādiqīna","en":"truthful","tr":"","pa":"اسم","pt":"İsim","da":"اسم فاعل، منصوب، مذكر جمع","dt":"İsm-i fâil, Mansûb, Müzekker cemi","r":"ص د ق"}]},"7":{"m":{"210":"Ama onlar elleriyle işledikleri yüzünden onu hiç temenni edemezler. Allah, zalimleri çok iyi bilir.","77":"Yaptıklarından ötürü, ölümü asla dileyemezler. Allah, zalimleri bilendir.","52":"Ama onlar, ellerinin (yapıp) öne sürdüğü (işler) yüzünden ölümü asla temenni etmezler. Allah zalimleri bilir.","112":"Ama onlar elleriyle işledikleri yüzünden onu hiç temenni edemezler. Allah, zalimleri bilir.","124":"Ama onlar, önceden yaptıklarından dolayı ölümü asla temenni etmezler. Allah, zalimleri çok iyi bilir."},"w":[{"ar":"وَلَا","tl":"walā","en":"But not","tr":"","pa":"حرف استئناف + حرف نفي","pt":"İsti'nâf harfi + Nefy harfi","da":"","dt":"","r":""},{"ar":"يَتَمَنَّوْنَهُۥٓ","tl":"yatamannawnahu","en":"they will wish for it","tr":"","pa":"فعل مضارع + ضمير + ضمير","pt":"Fi'l-i muzâri + Zamir + Zamir","da":"الوزن V، مرفوع، غائب مذكر جمع","dt":"tefa''ul bâbı, Merfû, Gâib müzekker cemi","r":"م ن ي"},{"ar":"أَبَدًۢا","tl":"abadan","en":"ever","tr":"","pa":"ظرف زمان","pt":"Zaman zarfı","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"أ ب د"},{"ar":"بِمَا","tl":"bimā","en":"for what","tr":"","pa":"حرف جر + اسم موصول","pt":"Harf-i cer + İsm-i mevsûl","da":"","dt":"","r":""},{"ar":"قَدَّمَتْ","tl":"qaddamat","en":"(have) sent forth","tr":"","pa":"فعل ماض","pt":"Fi'l-i mâzî","da":"الوزن II، غائب مؤنث مفرد","dt":"tef'îl bâbı, Gâib müennes müfred","r":"ق د م"},{"ar":"أَيْدِيهِمْ ۚ","tl":"aydīhim","en":"their hands","tr":"","pa":"اسم + ضمير","pt":"İsim + Zamir","da":"مرفوع، مؤنث جمع","dt":"Merfû, Müennes cemi","r":"ي د ي"},{"ar":"وَٱللَّهُ","tl":"wal-lahu","en":"And Allah","tr":"","pa":"حرف استئناف + اسم علم","pt":"İsti'nâf harfi + Özel isim","da":"مرفوع","dt":"Merfû","r":"أ ل ه"},{"ar":"عَلِيمٌۢ","tl":"ʿalīmun","en":"(is) All-Knowing","tr":"","pa":"اسم","pt":"İsim","da":"مرفوع، مذكر مفرد","dt":"Merfû, Müzekker müfred","r":"ع ل م"},{"ar":"بِٱلظَّـٰلِمِينَ","tl":"bil-ẓālimīna","en":"of the wrongdoers","tr":"","pa":"حرف جر + اسم","pt":"Harf-i cer + İsim","da":"اسم فاعل، مجرور، مذكر جمع","dt":"İsm-i fâil, Mecrûr, Müzekker cemi","r":"ظ ل م"}]},"8":{"m":{"210":"De ki: \"Kendisinden kaçtığınız ölüm, size mutlaka ulaşacaktır. Sonra da gaybın ve görüleni bilen Allah'a döndürüleceksiniz. O da size yapmakta olduklarınızı haber verecektir.\"","77":"De ki: \"Doğrusu kendisinden kaçtığınız ölüm mutlaka karşınıza çıkacaktır; sonra; görüleni de görülmeyeni de bilen Allah'a döndürüleceksiniz, O size işlediklerinizi haber verecektir.\"","52":"De ki: \"Sizin kendisinden kaçtığınız ölüm, muhakkak sizi bulacaktır. Sonra görünmeyeni ve görüneni bilene döndürüleceksiniz. O size (bütün) yaptıklarınızı haber verecektir.","112":"De ki: Kendisinden kaçtığınız ölüm, size mutlaka ulaşacaktır. Sonra da gaybın ve görüleni bilen Allah'a döndürüleceksiniz, O da size yapmakta olduklarınızı haber verecektir.","124":"De ki: Sizin kendisinden kaçtığınız ölüm, muhakkak sizi bulacaktır. Sonra da görüleni ve görülmeyeni bilen Allah'a döndürüleceksiniz de O size bütün yaptıklarınızı haber verecektir ."},"w":[{"ar":"قُلْ","tl":"qul","en":"Say","tr":"","pa":"فعل أمر","pt":"Fi'l-i emr","da":"الوزن I، مخاطب مذكر مفرد","dt":"mücerred bâbı, Muhâtab müzekker müfred","r":"ق و ل"},{"ar":"إِنَّ","tl":"inna","en":"Indeed","tr":"","pa":"حرف نصب","pt":"Nasb harfi","da":"","dt":"","r":""},{"ar":"ٱلْمَوْتَ","tl":"l-mawta","en":"the death","tr":"","pa":"اسم","pt":"İsim","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"م و ت"},{"ar":"ٱلَّذِى","tl":"alladhī","en":"which","tr":"","pa":"
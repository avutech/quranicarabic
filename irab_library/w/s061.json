mayacağınız bir şeyi söylemek Allah katında nefret edilen bir şeydir.","124":"Yapmayacağınız şeyleri söylemeniz, Allah katında büyük bir nefretle karşılanır."},"w":[{"ar":"كَبُرَ","tl":"kabura","en":"Great is","tr":"büyüktür","pa":"فعل ماض","pt":"Fi'l-i mâzî","da":"الوزن I، غائب مذكر مفرد","dt":"mücerred bâbı, Gâib müzekker müfred","r":"ك ب ر"},{"ar":"مَقْتًا","tl":"maqtan","en":"hatred","tr":"gazap bakımından","pa":"اسم","pt":"İsim","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"م ق ت"},{"ar":"عِندَ","tl":"ʿinda","en":"with","tr":"katında","pa":"ظرف مكان","pt":"Mekân zarfı","da":"منصوب","dt":"Mansûb","r":"ع ن د"},{"ar":"ٱللَّهِ","tl":"l-lahi","en":"Allah","tr":"Allah","pa":"اسم علم","pt":"Özel isim","da":"مجرور","dt":"Mecrûr","r":"أ ل ه"},{"ar":"أَن","tl":"an","en":"that","tr":"-meniz","pa":"حرف مصدري","pt":"Masdar harfi","da":"","dt":"","r":""},{"ar":"تَقُولُوا۟","tl":"taqūlū","en":"you say","tr":"söyle-","pa":"فعل مضارع + ضمير","pt":"Fi'l-i muzâri + Zamir","da":"الوزن I، منصوب، مخاطب مذكر جمع","dt":"mücerred bâbı, Mansûb, Muhâtab müzekker cemi","r":"ق و ل"},{"ar":"مَا","tl":"mā","en":"what","tr":"şeyi","pa":"اسم موصول","pt":"İsm-i mevsûl","da":"","dt":"","r":""},{"ar":"لَا","tl":"lā","en":"not","tr":"-mediğiniz","pa":"حرف نفي","pt":"Nefy harfi","da":"","dt":"","r":""},{"ar":"تَفْعَلُونَ","tl":"tafʿalūna","en":"you do","tr":"yap-","pa":"فعل مضارع + ضمير","pt":"Fi'l-i muzâri + Zamir","da":"الوزن I، مرفوع، مخاطب مذكر جمع","dt":"mücerred bâbı, Merfû, Muhâtab müzekker cemi","r":"ف ع ل"}]},"4":{"m":{"210":"Allah, kendi yolunda kenetlenmiş bir yapı gibi saf halinde savaşanları sever.","77":"Doğrusu Allah, kendi uğrunda, kenetlenmiş bir duvar gibi, saf halinde çarpışanları sever.","52":"Allah, kendi yolunda kenetlenmiş bir duvar gibi saf bağlayarak savaşanları sever.","112":"Allah, kendi yolunda kenetlenmiş bir yapı gibi saf halinde savaşanları sever.","124":"Allah, kendi yolunda kenetlenmiş bir yapı gibi saf bağlayarak savaşanları sever."},"w":[{"ar":"إِنَّ","tl":"inna","en":"Indeed","tr":"şüphesiz","pa":"حرف نصب","pt":"Nasb harfi","da":"","dt":"","r":""},{"ar":"ٱللَّهَ","tl":"l-laha","en":"Allah","tr":"Allah","pa":"اسم علم","pt":"Özel isim","da":"منصوب","dt":"Mansûb","r":"أ ل ه"},{"ar":"يُحِبُّ","tl":"yuḥibbu","en":"loves","tr":"sever","pa":"فعل مضارع","pt":"Fi'l-i muzâri","da":"الوزن IV، مرفوع، غائب مذكر مفرد","dt":"if'âl bâbı, Merfû, Gâib müzekker müfred","r":"ح ب ب"},{"ar":"ٱلَّذِينَ","tl":"alladhīna","en":"those who","tr":"kimseleri","pa":"اسم موصول","pt":"İsm-i mevsûl","da":"مذكر جمع","dt":"Müzekker cemi","r":""},{"ar":"يُقَـٰتِلُونَ","tl":"yuqātilūna","en":"fight","tr":"savaşan","pa":"فعل مضارع + ضمير","pt":"Fi'l-i muzâri + Zamir","da":"الوزن III، مرفوع، غائب مذكر جمع","dt":"mufâale bâbı, Merfû, Gâib müzekker cemi","r":"ق ت ل"},{"ar":"فِى","tl":"fī","en":"in","tr":"-da","pa":"حرف جر","pt":"Harf-i cer","da":"","dt":"","r":""},{"ar":"سَبِيلِهِۦ","tl":"sabīlihi","en":"His Way","tr":"yolun-","pa":"اسم + ضمير","pt":"İsim + Zamir","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"س ب ل"},{"ar":"صَفًّۭا","tl":"ṣaffan","en":"(in) a row","tr":"saf bağlayarak","pa":"اسم","pt":"İsim","da":"مصدر، منصوب، مذكر","dt":"Masdar, Mansûb, Müzekker","r":"ص ف ف"},{"ar":"كَأَنَّهُم","tl":"ka-annahum","en":"as if they","tr":"sanki onlar","pa":"حرف نصب + ضمير","pt":"Nasb harfi + Zamir","da":"","dt":"","r":""},{"ar":"بُنْيَـٰنٌۭ","tl":"bun'yānun","en":"(were) a structure","tr":"bir bina","pa":"اسم","pt":"İsim","da":"مرفوع، مذكر","dt":"Merfû, Müzekker","r":"ب ن ي"},{"ar":"مَّرْصُوصٌۭ","tl":"marṣūṣun","en":"joined firmly","tr":"birbirine kenetlenmiş","pa":"صفة","pt":"Sıfat","da":"اسم مفعول، مرفوع، مذكر","dt":"İsm-i mef'ûl, Merfû, Müzekker","r":"ر ص ص"}]},"5":{"m":{"210":"Hani Musa, kendi kavmine demişti ki: “Ey kavmim! Gerçekten benim sizin için Allah'tan gönderilmiş bir elçi olduğumu bildiğiniz halde, niçin bana eziyet ediyorsunuz?” demişti. Onlar (hak yoldan) sapınca, Allah da onların kalplerini saptırdı. Allah, fasık kavme hidayet etmez.","77":"Musa milletine: \"Ey milletim! Beni niçin incitirsiniz? Oysa, benim size gönderilmiş Allah'ın bir peygamberi olduğumu biliyorsunuz\" demişti. Ama onlar yoldan sapınca, Allah da onların kalblerini saptırmıştı. Allah, yoldan çıkan milleti doğru yola eriştirmez.","52":"Bir zaman Musa, kavmine: \"Ey kavmim! Benim, Allah'ın size gönderdiği elçisi olduğumu bildiğiniz halde niçin beni incitiyorsunuz?\" demişti. Onlar eğrilince, Allah da kalblerini eğriltti. Allah fasıkları doğru yola iletmez.","112":"Hani Musa, kavmine: Ey kavmim! Benim Allah’ın size gönderdiği elçisi olduğumu iyi bildiğiniz halde ne diye bana eziyet ediyorsunuz? demişti. Onlar (hak yoldan) sapınca, Allah da onların kalplerini saptırdı. Allah, fasık kavme hidayet etmez.","124":"Bir zaman Musa kavmine: Ey kavmim! Benim, Allah'ın size gönderdiği elçisi olduğumu bildiğiniz halde niçin beni incitiyorsunuz? demişti. Onlar yoldan sapınca, Allah da kalplerini saptırmıştı. Allah, fâsıklar topluluğunu doğru yola iletmez."},"w":[{"ar":"وَإِذْ","tl":"wa-idh","en":"And when","tr":"ve hani","pa":"حرف استئناف + ظرف زمان","pt":"İsti'nâf harfi + Zaman zarfı","da":"","dt":"","r":""},{"ar":"قَالَ","tl":"qāla","en":"said","tr":"demişti","pa":"فعل ماض","pt":"Fi'l-i mâzî","da":"الوزن I، غائب مذكر مفرد","dt":"mücerred bâbı, Gâib müzekker müfred","r":"ق و ل"},{"ar":"مُوسَىٰ","tl":"mūsā","en":"Musa","tr":"Mûsâ","pa":"اسم علم","pt":"Özel isim","da":"مرفوع، مذكر","dt":"Merfû, Müzekker","r":""},{"ar":"لِقَوْمِهِۦ","tl":"liqawmihi","en":"to his people","tr":"kavmine","pa":"حرف جر + اسم + ضمير","pt":"Harf-i cer + İsim + Zamir","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"ق و م"},{"ar":"يَـٰقَوْمِ","tl":"yāqawmi","en":"O my people","tr":"ey kavmim","pa":"حرف نداء + اسم + ضمير","pt":"Nidâ harfi + İsim + Zamir","da":"منصوب، مذكر","dt":"Mansûb, Müzekker","r":"ق و م"},{"ar":"لِمَ","tl":"lima","en":"Why","tr":"niçin","pa":"حرف جر + أداة استفهام","pt":"Harf-i cer + İstifhâm edatı","da":"","dt":"","r":""},{"ar":"تُؤْذُونَنِى","tl":"tu'dhūnanī"
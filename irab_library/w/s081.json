":"a withholder","tr":"cimri (kıskanç)","pa":"حرف جر + اسم","pt":"Harf-i cer + İsim","da":"مجرور، مذكر مفرد","dt":"Mecrûr, Müzekker müfred","r":"ض ن ن"}]},"25":{"m":{"20":"And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].","85":"This is not the word of an outcast devil.","210":"O, kovulmuş Şeytan'ın sözü de değildir.","77":"Bu Kuran, kovulmuş şeytanın sözü olamaz.","52":"O, kovulmuş bir şeytanın sözü değildir.","112":"O, kovulmuş şeytanın sözü de değildir.","124":"O lanetlenmiş şeytanın sözü de değildir."},"w":[{"ar":"وَمَا","tl":"wamā","en":"And not","tr":"ve değildir","pa":"حرف عطف + حرف نفي","pt":"Atıf harfi + Nefy harfi","da":"","dt":"","r":""},{"ar":"هُوَ","tl":"huwa","en":"it","tr":"o","pa":"ضمير","pt":"Zamir","da":"غائب مذكر مفرد","dt":"Gâib müzekker müfred","r":""},{"ar":"بِقَوْلِ","tl":"biqawli","en":"(is the) word","tr":"sözü","pa":"حرف جر + اسم","pt":"Harf-i cer + İsim","da":"مصدر، مجرور، مذكر","dt":"Masdar, Mecrûr, Müzekker","r":"ق و ل"},{"ar":"شَيْطَـٰنٍۢ","tl":"shayṭānin","en":"(of) Shaitaan","tr":"bir şeytanın","pa":"اسم","pt":"İsim","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"ش ط ن"},{"ar":"رَّجِيمٍۢ","tl":"rajīmin","en":"accursed","tr":"kovulmuş","pa":"صفة","pt":"Sıfat","da":"مجرور، مذكر مفرد","dt":"Mecrûr, Müzekker müfred","r":"ر ج م"}]},"26":{"m":{"20":"So where are you going?","85":"So where are you [people] going?","210":"Öyleyse nereye gidiyorsunuz?","77":"Nereye gidiyorsunuz?","52":"Hâl böyle iken, siz nereye gidiyorsunuz?","112":"Öyleyse nereye gidiyorsunuz?","124":"Hal böyle iken nereye gidiyorsunuz?"},"w":[{"ar":"فَأَيْنَ","tl":"fa-ayna","en":"So where","tr":"o hâlde nereye","pa":"حرف استئناف + أداة استفهام","pt":"İsti'nâf harfi + İstifhâm edatı","da":"","dt":"","r":""},{"ar":"تَذْهَبُونَ","tl":"tadhhabūna","en":"are you going","tr":"gidiyorsunuz?","pa":"فعل مضارع + ضمير","pt":"Fi'l-i muzâri + Zamir","da":"الوزن I، مرفوع، مخاطب مذكر جمع","dt":"mücerred bâbı, Merfû, Muhâtab müzekker cemi","r":"ذ ه ب"}]},"
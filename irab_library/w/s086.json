Müennes","r":"ق و ي"},{"ar":"وَلَا","tl":"walā","en":"and not","tr":"ve ne de","pa":"حرف عطف + حرف نفي","pt":"Atıf harfi + Nefy harfi","da":"","dt":"","r":""},{"ar":"نَاصِرٍۢ","tl":"nāṣirin","en":"any helper","tr":"bir yardımcı","pa":"اسم","pt":"İsim","da":"اسم فاعل، مجرور، مذكر","dt":"İsm-i fâil, Mecrûr, Müzekker","r":"ن ص ر"}]},"11":{"m":{"20":"By the sky which sends back","85":"By the sky and its recurring rain,","210":"Yağmurlu göğe andolsun.","77":"Dönüşlü göğe ve yarılan yeryüzüne and olsun ki,","52":"Andolsun o dönüşlü göğe,","112":"Yağmur yağdıran göğe,","124":"Dönüş sahibi olan (yağmur yağdıran) göğe,"},"w":[{"ar":"وَٱلسَّمَآءِ","tl":"wal-samāi","en":"By the sky","tr":"andolsun göğe","pa":"حرف جر + اسم","pt":"Harf-i cer + İsim","da":"مجرور، مؤنث","dt":"Mecrûr, Müennes","r":"س م و"},{"ar":"ذَاتِ","tl":"dhāti","en":"which","tr":"sahip","pa":"اسم","pt":"İsim","da":"مجرور، مؤنث مفرد","dt":"Mecrûr, Müennes müfred","r":""},{"ar":"ٱلرَّجْعِ","tl":"l-rajʿi","en":"returns","tr":"(yağmuru) geri döndürme(ye)","pa":"اسم","pt":"İsim","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"ر ج ع"}]},"12":{"m":{"20":"And [by] the earth which splits,","85":"by the earth that cracks open!","210":"Yarık yarık çatlamış yere andolsun.","77":"Dönüşlü göğe ve yarılan yeryüzüne and olsun ki,","52":"O yarılıp çatlayan yere,","112":"Çatlayan toprağa andolsun ki,","124":"(nebat ile) yarılan yere yemin ederim ki"},"w":[{"ar":"وَٱلْأَرْضِ","tl":"wal-arḍi","en":"And the earth","tr":"ve yere","pa":"حرف عطف + اسم","pt":"Atıf harfi + İsim","da":"مجرور، مؤنث","dt":"Mecrûr, Müennes","r":"أ ر ض"},{"ar":"ذَاتِ","tl":"dhāti","en":"which","tr":"sahip","pa":"اسم","pt":"İsim","da":"مجرور، مؤنث مفرد","dt":"Mecrûr, Müennes müfred","r":""},{"ar":"ٱلصَّدْعِ","tl":"l-ṣadʿi","en":"cracks open","tr":"yarılma(ya)","pa":"اسم","pt":"İsim","da":"مجرور، مذكر","dt":"Mecrûr, Müzekker","r":"ص د ع"}]},"13":{"m":{"20":"Indeed, it [i.e., the Qur’ān] is a decisive statement,","85":"This is truly a decisive statement;","21